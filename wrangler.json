{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bracketfish",
  "main": "./src/main.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "d0114b2d-b1a3-4105-bd1f-9f179b1349b7"
    }
  ],
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1",
      "simple": {
        "limit": 20,
        "period": 10
      }
    }
  ]
}
